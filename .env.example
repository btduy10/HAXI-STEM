# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.

# PostgreSQL (docker compose)
POSTGRES_USER=haxi
POSTGRES_PASSWORD=haxi_dev_password
POSTGRES_DB=haxi_edu
POSTGRES_PORT=5432
DATABASE_URL=postgres://haxi:haxi_dev_password@localhost:5432/haxi_edu
TEST_DATABASE_URL=postgres://haxi:haxi_dev_password@localhost:5432/haxi_edu_test

# Better Auth — tạo bí mật bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Khóa tài khoản khi đăng nhập sai
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mật khẩu tạm cho tài khoản admin khi chạy seed (bắt buộc đổi ở lần đăng nhập đầu)
SEED_DEFAULT_PASSWORD=Haxi@2026

# Gửi email (nút "Gửi tài khoản" ở trang Tài khoản). Gmail: bật Xác minh 2 bước rồi tạo "mật khẩu ứng dụng" (xem README).
# Chưa khai báo SMTP_USER/SMTP_PASS thì nút báo "Chưa cấu hình gửi email".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=HAXI STEM <dia-chi@gmail.com>

# Tác vụ hằng ngày bổ sung buổi học đến hết tuần sau (/api/cron/generate-sessions, Vercel Cron gọi lúc 00:05 giờ Việt Nam).
# Đặt một chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Chưa khai báo thì đường dẫn này luôn từ chối và tác vụ không chạy.
# CRON_SECRET=

# Production luôn ép HTTPS (chuyển hướng, HSTS, cookie Secure). Chỉ đặt false khi thử `npm run build && npm start` trên máy qua HTTP.
# FORCE_HTTPS=false


# Chỉ cần khi triển khai serverless (Netlify) với CSDL dùng pooler. Xem README.
# DB_POOL_MAX=3
# DB_PREPARE=false
# CLIENT_IP_HEADER=x-nf-client-connection-ip


# Admin bắt buộc bật xác thực hai lớp (mặc định). Chỉ đặt false khi chạy thử, không dùng với dữ liệu thật.
# ADMIN_2FA_REQUIRED=false

